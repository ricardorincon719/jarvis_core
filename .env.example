JARVIS_SECRET_TOKEN=jarvis_local_123
PEARL_PRODUCT=PEARL Lite
PEARL_EDITION=lite
PEARL_VERSION=0.7.0-beta.1
JARVIS_SESSION_TTL_SECONDS=2592000
PEARL_DEVICE_SESSION_MAX=100
# PEARL_DEVICE_SESSIONS_FILE=/ruta/privada/device_sessions.json
PEARL_ACTION_PROPOSAL_TTL_SECONDS=180
# PEARL_ACTION_PROPOSALS_FILE=/ruta/privada/action_proposals.json
PEARL_HUB_API_TIMEOUT=8
# Debe coincidir con el Hub cuando quieras exigir que decisiones pasen por Core.
PEARL_CORE_GATEWAY_TOKEN=
PEARL_DEVICE_SIGNATURE_MAX_SKEW_SECONDS=300
JARVIS_CORE_HOST=0.0.0.0
JARVIS_CORE_PORT=5004
JARVIS_CORE_DEBUG=false
JARVIS_MUSIC_HOST=jarvis-node.local
JARVIS_MUSIC_PORT=5005
JARVIS_ORCHESTRATOR_URL=http://jarvis-node.local:5006
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Opcionales: aparecen como HTTP-Referer y X-Title en OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PEARL HOME
OPENROUTER_TIMEOUT_SECONDS=120
# Nova sólo recibe consultas que el router determinista asigna a local_ia.
PEARL_NOVA_ENABLED=false
PEARL_NOVA_URL=http://127.0.0.1:5010
PEARL_NOVA_SESSION_ID=pearl:console:user:ricardo
PEARL_NOVA_TIMEOUT_SECONDS=120
PEARL_NOVA_EVENT_DB=~/.local/share/pearl-home/nova_event_bus.db
PEARL_NOVA_EVENT_TIMEOUT_SECONDS=5
PEARL_NOVA_EVENT_RETRY_SECONDS=15
JARVIS_SCENE_MEMORY_MIN_REPETITIONS=2
JARVIS_SCENE_MEMORY_MIN_UNIQUE_DAYS=2
# Opcional: ignora eventos anteriores a esta fecha ISO, por ejemplo 2026-05-17.
JARVIS_SCENE_MEMORY_MIN_DATE=
SERPAPI_KEY=

# Tuya Cloud opcional para completar local_key automaticamente durante discovery.
# TUYA_CLOUD_REGION: us, eu, cn o in. Tambien puedes usar TUYA_CLOUD_ENDPOINT directo.
TUYA_CLOUD_ACCESS_ID=
TUYA_CLOUD_ACCESS_KEY=
TUYA_CLOUD_REGION=us
TUYA_CLOUD_ENDPOINT=
